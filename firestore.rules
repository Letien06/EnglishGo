rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // All user profile and subcollection mutations go through Next.js API routes
    // using Firebase Admin SDK. Denying client writes prevents self-privilege
    // escalation (role), stat/streak/XP forgery, and anti-cheat bypasses.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /{subcollection=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Active multiplayer rooms: allow direct document get by room code for
    // realtime onSnapshot subscriptions of signed-in learners, but prevent
    // unauthenticated access and room enumeration (list).
    match /gameRooms/{code} {
      allow get: if signedIn();
      allow list, write: if false;

      match /players/{uid} {
        allow read, write: if false;
      }
    }

    // Everything else is served via authenticated/public Next.js API routes.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
