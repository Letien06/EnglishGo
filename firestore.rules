rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow create, read, update: if isOwner(uid);
      allow delete: if false;

      match /{subcollection}/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && !(subcollection in ['practiceAttempts', 'vocabStudyHistory', 'rateLimits', 'leaderboardBest', 'dictationLessonProgress']);
      }

      match /practiceDrafts/{draftId} {
        allow read, write: if isOwner(uid);
      }

      match /practiceAttempts/{attemptId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /leaderboardBest/{scopeId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /vocabGameDrafts/{draftId} {
        allow read, write: if isOwner(uid);
      }

      match /vocabStudyHistory/{historyId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /rateLimits/{limitId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /dictationLessonProgress/{lessonId} {
        allow read: if isOwner(uid);
        allow write: if false;

        match /segments/{segmentId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }
    }

    match /vocabSets/{setId} {
      allow read: if resource.data.status == 'PUBLISHED';
      allow write: if false;
    }

    match /vocabWords/{wordId} {
      allow read: if true;
      allow write: if false;
    }

    match /vocabFolders/{folderId} {
      allow read: if resource.data.publicShared == true;
      allow write: if false;
    }

    match /targets/{targetId}/comments/{commentId} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboards/{period}/entries/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /mediaAssets/{assetId} {
      allow read: if true;
      allow write: if false;
    }

    match /dictationLessons/{lessonId} {
      allow read: if resource.data.status == 'PUBLISHED';
      allow write: if false;

      match /segments/{segmentId} {
        // Segment documents include expectedText. Public clients must use the
        // server DTO, which strips answers before an attempt is submitted.
        allow read: if false;
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
