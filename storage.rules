rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public media reads; all uploads are authenticated and validated on the
    // server via Firebase Admin SDK (POST /api/admin/media).
    match /audio/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /images/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
