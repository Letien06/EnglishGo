# ---- Firebase Admin (server-side) ----
# Single-line JSON of the Firebase service account.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=

# ---- Firebase Web SDK (client-side, safe to expose) ----
NEXT_PUBLIC_FIREBASE_WEB_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Admin ----
ADMIN_EMAILS=

# ---- Scheduled jobs ----
# Used by Vercel Cron as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# ---- Redis edge protection (Upstash REST) ----
# Configure both in Vercel. Keep the token server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set both to true in production after the Redis health check has passed.
RATE_LIMIT_FAIL_CLOSED=false
CONCURRENCY_LIMIT_FAIL_CLOSED=false
# Values are per source IP in a 60-second sliding window.
RATE_LIMIT_HEALTH_PER_MIN=120
RATE_LIMIT_CATALOG_PER_MIN=600
RATE_LIMIT_PUBLIC_READ_PER_MIN=600
RATE_LIMIT_AUTH_READ_PER_MIN=1200
RATE_LIMIT_WRITE_PER_MIN=120
RATE_LIMIT_SEPAY_WEBHOOK_PER_MIN=600
RATE_LIMIT_AI_PER_MIN=20
# Distributed semaphore limits across all serverless instances.
FIREBASE_MAX_CONCURRENCY=160
GEMINI_MAX_CONCURRENCY=12
GEMINI_TIMEOUT_MS=20000

# ---- Gemini AI ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Dau English external content API (legacy variable names retained) ----
DAUTOEIC_SUPABASE_URL=https://odlnhfaygiotcyehuysw.supabase.co
DAUTOEIC_ANON_KEY=
DAUTOEIC_MEDIA_BASE_URL=https://odlnhfaygiotcyehuysw.supabase.co/storage/v1/object/public/mock-test-media
DAUTOEIC_CONTENT_STORAGE=firestore
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_MANIFEST_ID=

# ---- Media storage (Firebase Storage) ----
FIREBASE_STORAGE_BUCKET=
MEDIA_BASE_URL=
# Media sync writes stable dauenglish/<testId>/part-<part>/... objects here.

# ---- SePay: Premium status test (no learning feature restrictions) ----
# Use the same private API key in the SePay webhook configuration.
SEPAY_WEBHOOK_API_KEY=
# For MB: MBBank. Gateway must match SePay's webhook gateway value.
SEPAY_BANK_CODE=
SEPAY_BANK_GATEWAY=
SEPAY_BANK_ACCOUNT_NUMBER=
SEPAY_BANK_ACCOUNT_NAME=
# Actual bank transfer in VND; the small default is for integration testing.
SEPAY_PREMIUM_AMOUNT=2000
