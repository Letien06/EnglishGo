# Copy this file to .env and fill in your local values.
# Do not commit .env or Firebase service account JSON files.

FIREBASE_SERVICE_ACCOUNT_PATH=C:/secrets/englishwebapp-firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_WEB_API_KEY=your_web_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_APP_ID=your_firebase_app_id

# Comma-separated Firebase login emails that should get ROLE_ADMIN locally.
ADMIN_EMAILS=you@example.com

# Google Gemini API for vocabulary generation.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Production/Supabase PostgreSQL. Use the JDBC form of the Supabase connection URL.
# Example: jdbc:postgresql://db.your-project.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=jdbc:postgresql://db.your-project.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_supabase_database_password
DATABASE_POOL_SIZE=5
SPRING_PROFILES_ACTIVE=prod
MEDIA_BASE_URL=https://your-app.example.com/media
