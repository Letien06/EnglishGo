FROM eclipse-temurin:17-jdk AS build

WORKDIR /workspace
COPY .mvn .mvn
COPY mvnw pom.xml ./
RUN chmod +x mvnw && ./mvnw -DskipTests dependency:go-offline

COPY src src
RUN ./mvnw -DskipTests package

FROM eclipse-temurin:17-jdk

WORKDIR /app
ENV SPRING_PROFILES_ACTIVE=prod
ENV PORT=8080
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

COPY --from=build /workspace/target/englishwebapp-0.0.1-SNAPSHOT.jar /app/app.jar
COPY scripts/vercel-start.sh /app/vercel-start.sh
COPY scripts/VercelBootstrap.java /app/VercelBootstrap.java
RUN chmod +x /app/vercel-start.sh && ln -sf /opt/java/openjdk/bin/java /usr/local/bin/java
EXPOSE 8080

CMD ["java", "/app/VercelBootstrap.java"]
